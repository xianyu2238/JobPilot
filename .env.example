# Copy to .env for local development. Never commit real credentials.
JOBPILOT_APP_NAME=JobPilot
JOBPILOT_ENVIRONMENT=development
JOBPILOT_LOG_LEVEL=INFO

# Chat Completions compatible service. Include /v1 if your provider requires it.
# AiHubMix example selected for this project. Fill the key locally only.
JOBPILOT_LLM_BASE_URL=https://aihubmix.com/v1
JOBPILOT_LLM_API_KEY=
JOBPILOT_LLM_MODEL=qwen3.8-flash
# A model that accepts image_url inputs (required for PNG/scanned PDF).
JOBPILOT_VISION_MODEL=qwen3.8-flash
# AIHUBMIX_API_KEY is also accepted; JOBPILOT_LLM_API_KEY takes precedence.
JOBPILOT_LLM_JSON_MODE=true
# Qwen extraction tasks use non-thinking mode for faster JSON responses.
JOBPILOT_LLM_ENABLE_THINKING=false
JOBPILOT_LLM_TIMEOUT_SECONDS=90
JOBPILOT_PARSE_BUDGET_SECONDS=300
# Optional local proxy, for example http://127.0.0.1:7897
JOBPILOT_LLM_PROXY=

JOBPILOT_MAX_FILE_MB=5
JOBPILOT_MAX_PDF_PAGES=5
JOBPILOT_MAX_IMAGE_PIXELS=12000000
JOBPILOT_MAX_TEXT_CHARS=30000
JOBPILOT_OCR_CONFIDENCE_THRESHOLD=0.85
JOBPILOT_OCR_THREADS=4
JOBPILOT_STORE_CAPACITY=20
JOBPILOT_STORE_TTL_SECONDS=3600
# Streamlit connects to this local backend. No key is sent to the browser.
JOBPILOT_API_BASE_URL=http://127.0.0.1:8000

# PDF export: auto detects XeLaTeX or the project-local Tectonic binary.
JOBPILOT_LATEX_ENGINE=auto
JOBPILOT_LATEX_BINARY=
JOBPILOT_LATEX_TIMEOUT_SECONDS=120
# Warm dependencies with scripts/warm_latex.py before normal offline exports.
JOBPILOT_LATEX_ALLOW_DOWNLOADS=false
JOBPILOT_LATEX_PROXY=
